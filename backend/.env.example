# Copy to .env and export (or use your process manager). Never commit the real file.
REPOMIND_JWT_SECRET=change-me-to-a-long-random-string   # python -c "import secrets;print(secrets.token_urlsafe(48))"
ANTHROPIC_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Free local LLM option (no API key needed) ---
# 1. Install Ollama: https://ollama.com
# 2. Pull a model:   ollama pull llama3.1
# 3. In config.yaml, set generation.provider: ollama (already the default in
#    this project) and generation.ollama_model to match whatever you pulled.
# No env var needed for Ollama itself - it just needs to be running locally
# at generation.ollama_url (default http://localhost:11434).
# REPOMIND__generation__provider=ollama
# REPOMIND__embedding__backend=hashing
