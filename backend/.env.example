# Copy to .env and export (or use your process manager). Never commit the real file.
REPOMIND_JWT_SECRET=change-me-to-a-long-random-string   # python -c "import secrets;print(secrets.token_urlsafe(48))"
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Free option 1: Google Gemini API (no install, works immediately) ---
# 1. Get a free key: https://aistudio.google.com/apikey (no billing account needed)
# 2. Put it above as GEMINI_API_KEY=...
# 3. config.yaml is already set to generation.provider: gemini, model gemini-2.5-flash
#    (Google's free tier - no charge for this model as of writing).

# --- Free option 2: local LLM via Ollama (no API key, but a ~5GB download) ---
# 1. Install Ollama: https://ollama.com
# 2. Pull a model:   ollama pull llama3.1
# 3. In config.yaml, set generation.provider: ollama and generation.ollama_model
#    to match whatever you pulled.
# REPOMIND__generation__provider=ollama
# REPOMIND__embedding__backend=hashing
